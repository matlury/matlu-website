{
  "compilerOptions": {
    /* Speed & Vibe Optimization */
    "incremental": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Type Discovery (The "tough-cookie" fix) */
    "types": [
      "node",
      "react",
      "react-dom",
      "vitest/globals"
    ],
    /* Standards */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    /* Strictness */
    "strict": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    /* Path Aliases */
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/gql/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    ".next",
    "out",
    "matlu-cms",
    "matlu-nw"
  ]
}