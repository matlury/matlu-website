{
  "name": "matlufi",
  "private": true,
  "description": "Matlu.fi website",
  "version": "1.0.0",
  "author": "Matlu ry <yllapito@matlu.fi>",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "node scripts/optimize-logos.mjs && next build && npm run optimize",
    "optimize": "node optimize.mjs",
    "start": "echo \"Error: Use 'npm run serve' to test the static build locally.\" && exit 1",
    "serve": "npx serve@latest out",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint src scripts --fix",
    "typecheck": "tsc --noEmit",
    "typegen:scss": "typed-scss-modules src --exportType default",
    "format": "oxfmt --write src scripts",
    "format:check": "oxfmt --check src scripts",
    "test": "vitest",
    "lint:css": "biome lint src"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-form": "^1.33.5",
    "autoprefixer": "^10.4.27",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "graphql": "^16.15.0",
    "graphql-tag": "^2.12.7",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.32",
    "prop-types": "^15.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^6.3.0",
    "glob": "^14.0.5",
    "jsdom": "^31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "resize-observer-polyfill": "^1.5.1",
    "sass-embedded": "^1.108.2",
    "sharp": "^0.35.5",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "matlu",
    "matlufi"
  ],
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild@<=0.24.2": "^0.28.2",
    "picomatch@<4": "^4.0.4"
  }
}
