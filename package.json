{
  "name": "matlufi",
  "private": true,
  "description": "Matlu.fi website",
  "version": "1.0.0",
  "author": "Matlu ry <yllapito@matlu.fi>",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build && npm run optimize",
    "optimize": "node optimize.mjs",
    "start": "echo \"Error: Use 'npm run serve' to test the static build locally.\" && exit 1",
    "serve": "npx serve@latest out",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typegen:scss": "typed-scss-modules src --exportType default",
    "format": "prettier --write \"**/*.{js,jsx,json,md,ts,tsx}\"",
    "test": "vitest",
    "lint:css": "stylelint './src/**/*.scss'"
  },
  "dependencies": {
    "@apollo/client": "^4.1.3",
    "@chakra-ui/react": "^3.28.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-form": "^1.28.5",
    "autoprefixer": "^10.4.27",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "leaflet": "^1.9.4",
    "next": "^16.2.3",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.8",
    "prop-types": "^15.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.0.1",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-standard": "^4.1.0",
    "glob": "^13.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.34.5",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "matlu",
    "matlufi"
  ],
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0 <25"
  }
}