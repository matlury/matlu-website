    "prop-types": "^15.7.2",
    "qs": "^6.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
