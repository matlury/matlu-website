# =========================
# Stage 1: Build Gatsby site
# =========================
FROM registry.access.redhat.com/ubi8/nodejs-18 AS build

# Set working directory
WORKDIR /opt/app-root/src

# Copy package.json and lock file first (better caching)
COPY package*.json ./

# Install ALL dependencies (including devDependencies for Gatsby build)
RUN npm ci

# Copy the rest of the source code
COPY . .

# Increase Node memory limit (important for Gatsby builds)
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Build Gatsby site
RUN npm run build

# =========================
# Stage 2: Runtime (Nginx)
# =========================
FROM registry.access.redhat.com/ubi8/nginx-120

# Copy Gatsby build output to Nginx html directory
COPY --from=build /opt/app-root/src/public /usr/share/nginx/html

# Copy custom Nginx config (for client-side routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# OpenShift runs as non-root automatically
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]